generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id         String   @id @default(cuid())
  customerId String
  totalMinor Int
  channel    String   @default("web")
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}
